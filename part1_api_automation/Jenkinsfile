pipeline {
    agent any

    environment {
        VENV_NAME = 'venv'
        REPORT_DIR = 'reports'
    }

    stages {
        // 1. TC3 브랜치 코드 가져오기
        stage('Checkout (TC3)') {
            steps {
                // 젠킨스 설정에 적힌 브랜치(TC3)를 가져옵니다.
                checkout scm
            }
        }

        // 2. 환경 설정
        stage('Setup Environment') {
            steps {
                sh '''
                    # 리포트 폴더 생성
                    mkdir -p ${REPORT_DIR}

                    # 가상환경 생성 및 활성화
                    python3 -m venv ${VENV_NAME}
                    . ${VENV_NAME}/bin/activate
                    
                    # 필수 패키지 설치
                    pip install --upgrade pip
                    if [ -f requirements.txt ]; then
                        pip install -r requirements.txt
                    else
                        pip install pytest requests
                    fi
                '''
            }
        }

        // 3. ✨핵심✨ test_board.py만 실행하기
        stage('Run TestBoard Only') {
            steps {
                sh '''
                    . ${VENV_NAME}/bin/activate
                    
                    # 폴더 전체(tests/)가 아니라 파일명(test_board.py)을 지정했습니다!
                    python3 -m pytest tests/test_board.py --junitxml=${REPORT_DIR}/pytest_result.xml
                '''
            }
        }
    }

    // 4. 결과 리포트 (JMeter는 뺐으므로 Pytest 결과만 저장)
    post {
        always {
            junit "${REPORT_DIR}/pytest_result.xml"
        }
        success {
            echo "🎉 test_board.py 테스트 성공!"
        }
        failure {
            echo "💥 테스트 실패... 로그를 확인해주세요."
        }
    }
}