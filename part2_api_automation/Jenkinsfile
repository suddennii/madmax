pipeline {
    agent any
    
    environment {
        // VM 내의 JMeter 실행 경로 (실제 설치 경로로 수정 필요)
        JMETER_BIN = "jmeter" 
        WORKING_DIR = "part2_api_automation"
    }

    stages {
        stage('Clone Repository') {
            steps {
                // GitLab 주소 및 인증정보 설정
