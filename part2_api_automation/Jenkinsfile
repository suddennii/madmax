                    branch: 'main', 
                    credentialsId: 'oauth2' // Jenkins에 등록한 Credential ID
            }
        }
        stage('Connection Check') {
            steps {
                // 파일이 잘 가져와졌는지 폴더 목록만 출력해 봅니다.
                sh "ls -R"
                echo "✅ 깃랩 연결 및 파일 체크아웃 성공!"
            }
        }
